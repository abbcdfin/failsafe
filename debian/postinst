#!/bin/sh
set -e

case "$1" in
    configure)
        # Create directories with root:root 0755
        mkdir -p -m 0755 /etc/failsafe/detectors.d
        mkdir -p -m 0755 /var/lib/failsafe
        chown root:root /etc/failsafe/detectors.d /var/lib/failsafe 2>/dev/null || true
        chmod 0755 /etc/failsafe/detectors.d /var/lib/failsafe
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        ;;
esac

#DEBHELPER#

if [ "$1" = "configure" ] && [ -d /run/systemd/system ]; then
    systemctl --system daemon-reload
    if systemctl is-active --quiet failsafe.service; then
        # Service is currently running: restart it
        deb-systemd-invoke restart failsafe.service
    elif deb-systemd-helper --quiet was-enabled failsafe.service; then
        # Service is not running, but it is enabled (fresh install or reinstall): start it
        deb-systemd-invoke start failsafe.service
    else
        # Service was disabled by operator: leave it stopped
        :
    fi
fi

exit 0
