#!/bin/sh
set -e

case "$1" in
    purge)
        rm -rf /var/lib/failsafe
        rm -f /etc/failsafe/failsafe.toml
        rmdir /etc/failsafe/detectors.d 2>/dev/null || true
        rmdir /etc/failsafe 2>/dev/null || true
        ;;
    remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;
    *)
        ;;
esac

#DEBHELPER#

exit 0
